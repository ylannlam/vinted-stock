{
  "manifest_version": 3,
  "name": "Stock Vinted — veille des comptes",
  "version": "1.0.0",
  "minimum_chrome_version": "110",
  "description": "Signale à Stock Vinted quand Vinted affiche « Compte restreint » ou « Compte bloqué » sur ce compte.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.vinted.fr/*", "https://vinted-stock.vercel.app/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.vinted.fr/*"], "js": ["read.js", "content.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Veille du compte Vinted", "default_popup": "popup.html" }
}
