{
  "manifest_version": 3,
  "name": "YlaVint",
  "version": "3.8.4",
  "minimum_chrome_version": "120",
  "description": "YlaVint : le Bridge de tes comptes Vinted relié à ton site. Messagerie centralisée, agent IA, ventes et bordereaux, dressing, démasquage, prix, publication, messages aux likes.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.vinted.fr/*", "https://vinted-stock.vercel.app/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.vinted.fr/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.vinted.fr/*"], "js": ["read.js", "content.js", "form.js", "overlay.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "YlaVint", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } }
}
