{
  "manifest_version": 3,
  "name": "Stock Vinted — agent",
  "version": "2.0.0",
  "minimum_chrome_version": "111",
  "description": "Veille du compte Vinted et agent Stock Vinted : ventes, bordereaux, démasquage, prix, publication, messages aux likes.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.vinted.fr/*", "https://vinted-stock.vercel.app/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://www.vinted.fr/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://www.vinted.fr/*"], "js": ["read.js", "content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Agent Stock Vinted", "default_popup": "popup.html" }
}
