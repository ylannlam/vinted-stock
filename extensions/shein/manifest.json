{
  "manifest_version": 3,
  "name": "Stock Vinted — bibliothèque Shein",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Traiter les liens et SKU ajoutés sur Stock Vinted et enregistrer les fiches Shein dans la bibliothèque.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://fr.shein.com/*", "https://www.shein.com/*", "https://vinted-stock.vercel.app/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://vinted-stock.vercel.app/*"], "js": ["site-bridge.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "Bibliothèque Shein — récupération" }
}
