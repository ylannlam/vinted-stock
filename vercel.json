{
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/sales.js": {
      "includeFiles": "node_modules/pdfjs-dist/{standard_fonts/**,legacy/build/pdf.worker.mjs}"
    },
    "api/resources.js": {
      "includeFiles": "extensions/ylavint/**"
    }
  },
  "rewrites": [
    {
      "source": "/ylavint",
      "destination": "/ylavint.html"
    },
    {
      "source": "/ylavint/(.*)",
      "destination": "/ylavint.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
