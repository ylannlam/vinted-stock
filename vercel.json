{
  "regions": [
    "dub1"
  ],
  "images": {
    "sizes": [96, 256, 512],
    "qualities": [75],
    "formats": ["image/webp"],
    "localPatterns": [],
    "remotePatterns": [
      {"protocol":"https","hostname":"images1.vinted.net","port":"","pathname":"^/(t|tc)/.*$"}
    ],
    "minimumCacheTTL": 3600
  },
  "functions": {
    "api/sales.js": {
      "includeFiles": "node_modules/pdfjs-dist/{standard_fonts/**,legacy/build/pdf.worker.mjs}"
    },
    "api/resources.js": {
      "includeFiles": "{extensions/ylavint/**,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    },
    "api/collector.js": {
      "includeFiles": "node_modules/pdfjs-dist/{standard_fonts/**,legacy/build/pdf.worker.mjs}"
    }
  },
  "headers": [
    {
      "source": "/assets/:name([a-zA-Z0-9_.-]+-[a-zA-Z0-9_-]{8}\\.(?:js|css))",
      "headers": [{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]
    }
  ],
  "rewrites": [
    {
      "source": "/ylavint",
      "destination": "/ylavint.html"
    },
    {
      "source": "/ylavint/(.*)",
      "destination": "/ylavint.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
